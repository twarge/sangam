<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: a signed deployment adds
	     com.apple.developer.associated-domains with
	     applinks:<its-conference-domain> and hosts an
	     apple-app-site-association file. The key is not present by default
	     because it requires a provisioning profile even when empty. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.twarge.sangam</string>
	</array>
</dict>
</plist>

