  "targets": [
    {
      "name": "Sangam",
      "id": "A764E58F0B46676E3DCF34DB",
      "product": "Products/Sangam.app",
      "product-type": "application",
      "legacy-team-id": "257KW9ZJFP",
      "dependencies": [
        { "target": "SangamBroadcastExtension", "platforms": [ "ios" ] },
        { "target": "SangamWidgets", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "JitsiConference",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos" ] },
        }, {
          "product-name": "JitsiMedia",
          "build-phase": { "build-phase": "frameworks", "platforms": [ "ios", "macos" ] },
        }, {
          "product-name": "JitsiMeetingNotes",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "JitsiNativeCore",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES": "YES",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphoneos*]": "Sangam/SangamIOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]": "Sangam/SangamIOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Sangam/SangamMac.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=xros*]": "Sangam/SangamVision.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=xrsimulator*]": "Sangam/SangamVision.entitlements",
        "CODE_SIGN_IDENTITY": "iPhone Developer",
        "ENABLE_BITCODE": "NO",
        "INFOPLIST_FILE[sdk=iphoneos*]": "Sangam/Info-iOS.plist",
        "INFOPLIST_FILE[sdk=iphonesimulator*]": "Sangam/Info-iOS.plist",
        "INFOPLIST_FILE[sdk=macosx*]": "Sangam/Info-macOS.plist",
        "INFOPLIST_FILE[sdk=xros*]": "Sangam/Info-visionOS.plist",
        "INFOPLIST_FILE[sdk=xrsimulator*]": "Sangam/Info-visionOS.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "$(inherited)",
          "@executable_path/../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.sangam",
        "PRODUCT_NAME": "Sangam",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator xros xrsimulator macosx",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TARGETED_DEVICE_FAMILY[sdk=xros*]": "7",
        "TARGETED_DEVICE_FAMILY[sdk=xrsimulator*]": "7",
      },
    }, {
      "name": "SangamWidgets",
      "id": "8C409DDAF3F54BDBE2173257",
